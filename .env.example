# Sample environment for several chat endpoints.
# Copy this file to .env and replace the placeholder secrets.
# .env is gitignored. Keep real keys here, not in the JSON file.

DISCORD_TOKEN=replace-me

# Path is relative to the working directory.
# Docker uses /data, so place this file on the volume.
# endpoints.example.json is the matching endpoint list.
ENDPOINTS_CONFIG=endpoints.example.json

# Names used by api_key_env in that file.
OPENAI_API_KEY=replace-me
BACKUP_API_KEY=replace-me

# Must be listed in the endpoint file. This becomes the default model.
OPENAI_MODEL=gpt-4o-mini

# Optional provider/model tried after the requested model fails.
# It must be listed on that endpoint. When unset, failure continues
# through the other configured models.
# FALLBACK_MODEL=openai/gpt-4o

COMMAND_PREFIX=!knowsphere
WAKE_NAMES=KnownSphere,TransGPT

# Used only when ENDPOINTS_CONFIG is unset and endpoints.json is absent.
# OPENAI_API_BASE_URL=https://api.openai.com/v1
# OPENAI_PROVIDER=openai

# Forum mode. Tags are provider/model, such as openai/gpt-4o-mini.
# Each tag is at most 20 characters. A failed tag retries the backup model above.
# FORUM_TYPE_CHANNEL=
# FORUM_MODELS=gpt-4o-mini
